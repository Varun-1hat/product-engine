# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public base URL this app is reachable at from the internet; used to build
# provider webhook callback_urls (e.g. HeyGen /api/webhooks/heygen).
APP_PUBLIC_BASE_URL=http://localhost:3000

# ---- Supabase (single agency project) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. NEVER expose to the browser / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Orchestrating LLM (runtime skills: scene-brain, image-prompt, ----
# ---- brand-style-lock, brief-judge). The MODEL is chosen per reel in Stage 2 ----
# ---- (reel_config.orchestrator_model); these keys are agency-level. Set the ----
# ---- one(s) matching the models you offer. ----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Fallback model for reels created before the per-reel selector existed.
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Provider base URLs (overridable; per-client API KEYS live in Supabase ----
# ---- Vault via provider_keys, never in env/browser) ----
HEYGEN_BASE_URL=https://api.heygen.com
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
