# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public base URL this app is reachable at from the internet; used to build
# provider webhook callback_urls (e.g. HeyGen /api/webhooks/heygen).
APP_PUBLIC_BASE_URL=http://localhost:3000

# ---- Supabase (single agency project) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/worker only. Bypasses RLS. NEVER expose to the browser / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic (runtime skills: scene-brain, image-prompt, model-prompt, ----
# ---- brand-style-lock, brief-judge). Agency overhead, NOT written to cost_log. ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Provider base URLs (overridable; per-client API KEYS live in Supabase ----
# ---- Vault via provider_keys, never in env/browser) ----
HEYGEN_BASE_URL=https://api.heygen.com
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ---- Worker (worker/index.ts, worker/reconcile.ts) ----
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_MS=5000
WORKER_RECONCILE_INTERVAL_MS=15000
